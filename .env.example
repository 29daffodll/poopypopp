# Copy this file to ".env.local" in the project root, then restart: npm run dev
# Vite loads names starting with VITE_ or NEXT_PUBLIC_ (see vite.config.js envPrefix).

# Project URL (Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Client key: use "anon" JWT (eyJ...) or new publishable key (sb_publishable_...)
# Dashboard → Project Settings → API → anon / publishable
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alternative names (same values as above if you only have one key)
# VITE_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
