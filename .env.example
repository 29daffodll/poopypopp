# Copy this file to ".env.local" in the project root, then restart: npm run dev
# Vite loads names starting with VITE_ or NEXT_PUBLIC_ (see vite.config.js envPrefix).

# Project URL (Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Client key: use "anon" JWT (eyJ...) or new publishable key (sb_publishable_...)
# Dashboard → Project Settings → API → anon / publishable
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alternative names (same values as above if you only have one key)
# VITE_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe payment
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TEvkmGthsNM2V350J8uMmfNjBLZXMZOwbFSi0qUXZsRk6Wbn4m5LoPuCZQg2RyFIMWzx1HG6by19AT4sh84QKFU00GN5fFA3e
STRIPE_SECRET_KEY=sk_test_51TEvkmGthsNM2V35yAtcGL469SbNiiHi7DkIjCoFccfgVpDqrdMSEam3qMFLsrH32o4Ga63kJlz3LkHUt3TRqVgK00t73CsMMl
